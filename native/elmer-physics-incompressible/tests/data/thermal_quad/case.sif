! ThermalCompress_vec without its HeatSolve: the temperature is an exported
! variable of the flow solver held at its initial condition, linear in x
! (293.5 at x = 0 falling by 1 per unit x), so that only the "Compressibility
! Model = Thermal" terms of IncompressibleNS are exercised. Steady, the
! default MINI element, Picard (Newton after 20 is never reached).
Header
  Mesh DB "." "ThermalCompress_vec"
End
Simulation
  Max Output Level = 5
  Coordinate System = Cartesian 2D
  Simulation Type = Steady
  Steady State Max Iterations = 1
  Output File = "case.result"
End
Body 1
  Equation = 1
  Material = 1
  Body Force = 1
  Initial Condition = 1
End
Initial Condition 1
  Temperature = Variable Coordinate 1
    Real MATC "293.5-tx"
End
Body Force 1
  Flow BodyForce 2 = -10
End
Solver 1
  Equation = Navier-Stokes
  Procedure = "IncompressibleNS" "IncompressibleNSSolver"
  Exported Variable 1 = Temperature
  Nonlinear System Max Iterations = 10
  Nonlinear System Convergence Tolerance = 1.0e-10
  Nonlinear System Newton After Iterations = 20
  Nonlinear System Newton After Tolerance = 1.0e-3
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
End
Equation 1
  Active Solvers(1) = 1
End
Material 1
  Density = 1
  Viscosity = 1
  Reference Temperature = 293
  Compressibility Model = Thermal
  Heat Expansion Coefficient = 0.25
End
Boundary Condition 1
  Target Boundaries = 1
  Pressure = 0
  Velocity 1 = 0
  Velocity 2 = 0
End
Boundary Condition 2
  Target Boundaries = 2
  Velocity 1 = 0
  Velocity 2 = 0
End
Boundary Condition 3
  Target Boundaries = 3
  Velocity 1 = 0
  Velocity 2 = 0
End
Boundary Condition 4
  Target Boundaries = 4
  Velocity 1 = 0
  Velocity 2 = 0
End
