! tests/data/ns_tri/case.sif with the cross viscosity model, Newton after 3 iterations
! (the viscosity derivative in the Jacobian).
Header
  Mesh DB "." "steptri"
End
Simulation
  Max Output Level = 5
  Coordinate System = Cartesian 2D
  Simulation Type = Steady
  Steady State Max Iterations = 1
  Output File = "case.result"
End
Constants
End
Body 1
  Equation = 1
  Material = 1
  Initial Condition = 1
  
End
Initial Condition 1
  Velocity 1 = 0
  Velocity 2 = 0
End
Equation 1
  Active Solvers(1) = 1
End
Solver 1
  Equation = "NS-Vec"
  Procedure = "IncompressibleNS" "IncompressibleNSSolver"
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
  Pressure Stabilization = Logical True
  Nonlinear System Max Iterations = 60
  Nonlinear System Convergence Tolerance = 1.0e-10
  Nonlinear System Newton After Iterations = 3
  Pressure Stabilization Element Size = String "longest edge"
End
Material 1
  Density = 1
  Viscosity = 0.1
  Viscosity Model = cross
  Viscosity Difference = 0.2
  Viscosity Exponent = 1.3
  Viscosity Transition = 2.0
End
Boundary Condition 1
  Target Boundaries = 1
  Velocity 1 = Variable Coordinate 2
    Real MATC "(2-tx)*(tx-1)"
  Velocity 2 = 0
End
Boundary Condition 2
  Target Boundaries = 2
  Velocity 2 = 0
End
Boundary Condition 3
  Target Boundaries = 3
  Velocity 1 = 0
  Velocity 2 = 0
End
