Header
  Mesh DB "." "."
End
Simulation
  Max Output Level = 7
  Coordinate System = "Cartesian"
  Simulation Type = Steady
  Steady State Max Iterations = 1
End
Body 1
  Equation = 1
  Material = 1
End
Equation 1
  Active Solvers(1) = 1
End
Material 1
