Header
  Mesh DB "." "1d"
End
Simulation
  Max Output Level = 5
  Coordinate System = "Cartesian 1D"
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 1
  Timestep Intervals(1) = 6
  Timestep Sizes(1) = 0.2
  Output Intervals(1) = 1
  Steady State Max Iterations = 1
  Timestep Size = Variable Time
    Real
      0.0 0.05
      0.2 0.1
      1.0 0.3
    End
End
Body 1
  Equation = 1
  Material = 1
  Initial Condition = 1
End
Initial Condition 1
  Temperature = Real 0
End
Material 1
  Heat Conductivity = Real 1
  Density = Real 1
  Heat Capacity = Real 1
End
Equation 1
  Active Solvers(1) = 1
End
Solver 1
  Equation = "Heat Equation"
  Variable = "Temperature"
  Procedure = "HeatSolve" "HeatSolver"
  Linear System Solver = "Direct"
  Linear System Direct Method = "umfpack"
  Nonlinear System Max Iterations = 1
  Steady State Convergence Tolerance = 1e-9
End
Boundary Condition 1
  Target Boundaries(1) = 1
  Temperature = Real 1
End
Boundary Condition 2
  Target Boundaries(1) = 2
  Temperature = Real 0
End
