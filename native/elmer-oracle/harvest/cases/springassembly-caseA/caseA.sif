Header
  Mesh DB "." "square"
End
Simulation
  Max Output Level = 5
  Coordinate System = Cartesian 2D
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Steady State Min Iterations = 1
  Output Intervals = 1
End
Body 1
  Equation = 1
  Material = 1
End
Body 2
  Equation = 1
  Material = 1
End
Body 3
  Equation = 1
  Material = 1
End
Body 4
  Equation = 1
  Material = 1
End
Material 1
  Density = 1.0
  Youngs Modulus = 70e9
  Poisson Ratio = 0.3
End
Solver 1
  Equation = Elasticity Solver
  Variable = Displacement
  Variable DOFs = 2
  Procedure = "ElasticSolve" "ElasticSolver"
  Assembly Solvers(1) = 2
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStab
  Linear System Preconditioning = ILU2
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-10
  Linear System Residual Output = 20
  Nonlinear System Max Iterations = 1
  Steady State Convergence Tolerance = 1.0e-4
  Calculate Loads = Logical True
End
Solver 2
  Equation = "Assemble Springs"
  Exec Solver = Never
  Procedure = "SpringAssembly" "SpringAssembler"
  Displacement Variable Name = "Displacement"
End
Solver 3
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = Displacement
  Operator 1 = max
End
Equation 1
  Active Solvers(3) = 1 2 3
  Plane Stress = False
End
Boundary Condition 1
  Target Boundaries = 1
  Displacement 1 = 0
  Displacement 2 = 0
End
Boundary Condition 2
  Target Boundaries = 2
  Surface Traction 2 = Real -1.0e6
End
Boundary Condition 3
  Target Nodes(1) = 240
  Spring 2 = Real 1.0e8
End
