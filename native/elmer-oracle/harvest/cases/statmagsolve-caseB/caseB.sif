Header
  Mesh DB "." "crucible"
  Results Directory ""
End

Simulation
  Max Output Level = 5
  Coordinate System = "Axi Symmetric"
  Simulation Type = Steady State
  Steady State Max Iterations = 1
End

Body Force 1
  Current Density = 1.0e6
End

Body 1
  Name = "Air"
  Equation = 1
  Material = 1
End

Body 2
  Name = "Coil"
  Equation = 1
  Material = 1
  Body Force = 1
End

Body 3
  Name = "Insulation"
  Equation = 1
  Material = 2
End

Body 4
  Name = "Graphite"
  Equation = 1
  Material = 3
End

Body 5
  Name = "Powder"
  Equation = 1
  Material = 4
End

Equation 1
  Name = "Vector Potential Equation"
  Active Solvers = 1
End

Solver 1
  Equation = Potential Solver
  Procedure = "StatMagSolve" "StatMagSolver"
  Variable = Potential
  Variable DOFs = 2
  Frequency = Real 50.0e3
  Calculate Joule Heating = Logical False
  Calculate Magnetic Flux = Logical True
  Calculate Magnetic Flux Abs = Logical True
  Desired Heating Power = Real 3.0e3
  Linear System Solver = Direct
  Linear System Direct Method = umfpack
  Nonlinear System Max Iterations = 2
  Nonlinear System Convergence Tolerance = 1.0e-6
  Nonlinear System Relaxation Factor = 1
End

Material 1
  Name = "Air"
  Electrical Conductivity = 0.0
End

Material 2
  Name = "Insulation"
  Electrical Conductivity = 2.0E3
End

Material 3
  Name = "Graphite"
  Electrical Conductivity = 2.0E4
End

Material 4
  Name = "Powder"
  Electrical Conductivity = 1.0E4
End

Boundary Condition 1
  Target Boundaries = 1
  Potential 1 = Real 0.0
  Potential 2 = Real 0.0
End

Solver 2
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = Potential
  Operator 1 = min
  Variable 2 = Potential
  Operator 2 = max
End
