Header
  Mesh DB "." "square"
End
Simulation
  Coordinate System = Cartesian 2D
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 1
  Max Output Level = 4
End
Body 1
  Equation = 1
  Material = 1
End
Body 2
  Equation = 1
  Material = 1
End
Body 3
  Equation = 1
  Material = 1
End
Body 4
  Equation = 1
  Material = 1
End
Equation 1
  Active Solvers(1) = 1
End
Material 1
  Density = 1.0e-3
  Viscosity = 1.5
  Gap Height = 0.5
End
Boundary Condition 1
  Target Boundaries(1) = 1
  FilmVelocity 2 = Real 0.0
End
Boundary Condition 2
  Target Boundaries(1) = 2
  FilmVelocity 2 = Real 0.0
End
Boundary Condition 3
  Target Boundaries(1) = 3
  FilmVelocity 2 = Real 0.0
End
Boundary Condition 4
  Target Boundaries(1) = 4
  FilmVelocity 1 = Real 1.3
End
Solver 1
  Equation = FilmFlow
  Procedure = "FilmFlowSolver" "FilmFlowSolver"
  Model Dimension = Integer 2
  Nonlinear System Max Iterations = 1
  Nonlinear System Convergence Tolerance = 1.0e-6
  Linear System Solver = Direct
  Linear System Direct Method = umfpack
End
Solver 2
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = FilmPressure
  Operator 1 = min
  Variable 2 = FilmPressure
  Operator 2 = max
  Variable 3 = FilmVelocity 1
  Operator 3 = min
  Variable 4 = FilmVelocity 1
  Operator 4 = max
End
