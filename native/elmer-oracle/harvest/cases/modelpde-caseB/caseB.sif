Check Keywords "Warn"
Header
  Mesh DB "." "square"
End
Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 1
  Timestep Intervals = 2
  Timestep Sizes = 0.1
  Steady State Max Iterations = 1
  Output Intervals = 1
End
Body 1
  Equation = 1
  Material = 1
  Body Force = 1
  Initial Condition = 1
End
Body 2
  Equation = 1
  Material = 1
  Initial Condition = 1
End
Body 3
  Equation = 1
  Material = 1
  Initial Condition = 1
End
Body 4
  Equation = 1
  Material = 1
  Initial Condition = 1
End
Initial Condition 1
  Field = Real 0.0
End
Equation 1
  Active Solvers(1) = 1
End
Material 1
  diffusion coefficient = Real 2.0
  reaction coefficient = Real 0.5
  time derivative coefficient = Real 1.0
End
Body Force 1
  field source = Real 2.0
End
Boundary Condition 1
  Target Boundaries(2) = 1 2
  Field = Real 0.0
End
Boundary Condition 2
  Target Boundaries(1) = 3
  Robin Coefficient = Real 5.0
  External Field = Real 1.0
End
Boundary Condition 3
  Target Boundaries(1) = 4
  Field Flux = Real 3.0
End
Solver 1
  Equation = "ModelPDE"
  Variable = "Field"
  Procedure = "ModelPDE" "AdvDiffSolver"
  Linear System Solver = Direct
  Nonlinear System Max Iterations = 2
  Steady State Convergence Tolerance = Real 0.0
  Integ Test = Logical True
End
Solver 2
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = Field
  Operator 1 = min
  Variable 2 = Field
  Operator 2 = max
End
