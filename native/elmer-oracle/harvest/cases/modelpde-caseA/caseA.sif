Check Keywords "Warn"
Header
  Mesh DB "." "square"
End
Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 1
End
Body 1
  Equation = 1
  Material = 1
  Body Force = 1
End
Body 2
  Equation = 1
  Material = 1
End
Body 3
  Equation = 1
  Material = 1
End
Body 4
  Equation = 1
  Material = 1
  Body Force = 2
End
Equation 1
  Active Solvers(1) = 1
End
Material 1
  Convection Velocity 1 = Real 1.0
  Convection Velocity 2 = Real 0.0
  diffusion coefficient = Real 1.0
  convection coefficient = Real 9.0
  time derivative coefficient = Real 0.0
End
Body Force 1
  field source = Real 1.0
End
Body Force 2
  field source = Real -1.0
End
Boundary Condition 1
  Target Boundaries(1) = 1
  Field = Real 0.0
End
Boundary Condition 2
  Target Boundaries(1) = 2
  Robin Coefficient = Real 10.0
  External Field = Real 5.0
End
Boundary Condition 3
  Target Boundaries(2) = 3 4
  Field Flux = Real 10.0
End
Solver 1
  Equation = "ModelPDE"
  Variable = "Field"
  Procedure = "ModelPDE" "AdvDiffSolver"
  Linear System Solver = Direct
  Steady State Convergence Tolerance = Real 1.0e-9
End
Solver 2
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = Field
  Operator 1 = min
  Variable 2 = Field
  Operator 2 = max
End
