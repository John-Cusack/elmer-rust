Header
  Mesh DB "." "square"
End
Simulation
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 1
  Max Output Level = 4
End
Body 1
  Equation = 1
  Material = 1
  Body Force = 1
End
Body 2
  Equation = 1
  Material = 1
End
Body 3
  Equation = 1
  Material = 1
End
Body 4
  Equation = 1
  Material = 1
  Body Force = 2
End
Equation 1
  Active Solvers(1) = 1
End
Material 1
  Density = Real 1.0
  Heat Capacity = Real 1000.0
  Reference Temperature = Real 293.0
  Reference EPotential = Real 0.0
  Concentration Diffusivity = Real 0.1
End
Body Force 1
  Concentration Diffusion Source = Real 1.0
End
Body Force 2
  Concentration Diffusion Source = Real -1.0
End
Boundary Condition 1
  Target Boundaries(1) = 1
  Concentration = Real 0.0
End
Boundary Condition 2
  Target Boundaries(3) = 2 3 4
  Concentration Flux = Real 0.5
End
Solver 1
  Equation = "AdvDiff"
  Procedure = "AdvectionDiffusion" "AdvectionDiffusionSolver"
  Variable = "Concentration"
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStab
  Linear System Max Iterations = Integer 500
  Linear System Preconditioning = ILU0
  Linear System Convergence Tolerance = Real 1.0e-6
  Nonlinear System Max Iterations = Integer 1
End
Solver 2
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = Concentration
  Operator 1 = min
  Variable 2 = Concentration
  Operator 2 = max
End
