Header
  Mesh DB "." "square"
End
Simulation
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 1
End
Body 1
  Equation = 1
  Material = 1
  Initial Condition = 1
End
Body 2
  Equation = 1
  Material = 1
End
Body 3
  Equation = 1
  Material = 1
End
Body 4
  Equation = 1
  Material = 1
End
Equation 1
  Active Solvers(1) = 1
End
Material 1
  Density = 1.0
End
Initial Condition 1
  Comp 1 = Real 1.0
  Comp 2 = Real 0.5
End
Boundary Condition 1
  Target Boundaries(1) = 1
  Scalar Potential = Real 0.0
End
Boundary Condition 2
  Target Boundaries(3) = 2 3 4
  Scalar Potential = Real 1.0
End
Solver 1
  Equation = Scalar Potential
  Procedure = "ScalarPotentialSolver" "ScalarPotentialSolver"
  Flux Variable = String Comp
  Exported Variable 1 = Comp 1
  Exported Variable 2 = Comp 2
End
Solver 2
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = Scalar Potential
  Operator 1 = min
  Variable 2 = Scalar Potential
  Operator 2 = max
End
