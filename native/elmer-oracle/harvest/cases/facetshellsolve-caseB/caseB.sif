Header
  Mesh DB "." "squareq"
End
Simulation
  Coordinate System = Cartesian
  Max Output Level = 4
  Simulation Type = Steady State
  Steady State Max Iterations = 2
  Steady State Min Iterations = 2
  Output Intervals = 1
End
Body 1
  Equation = 1
  Material = 1
  Body Force = 1
End
Body 2
  Equation = 1
  Material = 1
End
Body 3
  Equation = 1
  Material = 1
End
Body 4
  Equation = 1
  Material = 1
End
Equation 1
  Active Solvers(1) = 1
End
Material 1
  Density = 7850.0
  Youngs modulus = 2.1e11
  Poisson ratio = 0.3
  Thickness = 0.01
End
Body Force 1
  Body Force 3 = -2000.0
  Pressure = 200.0
  Point Load (1,9) = Real 1.0 1.0 0.0 0.0 0.0 -500.0 0.0 0.0 0.0
End
Boundary Condition 1
  Target Boundaries(1) = 1
  Deflection 1 = 0.0
  Deflection 2 = 0.0
  Deflection 3 = 0.0
End
Boundary Condition 2
  Target Boundaries(1) = 3
  Force 3 = 800.0
End
Solver 1
  Equation = Shell
  Procedure = "FacetShellSolve" "ShellSolver"
  Variable = Deflection
  Variable DOFs = 6
  Linear System Solver = Direct
  Linear System Direct Method = Umfpack
  Large Deflection = Logical True
  Load Scale Factor = 1.5
End
Solver 2
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = Deflection
  Operator 1 = max
  Variable 2 = Deflection
  Operator 2 = min
End
