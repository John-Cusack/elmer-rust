Header
  Mesh DB "." "square"
End
Simulation
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 2
  Output Intervals = 1
  Max Output Level = 4
End
Body 1
  Equation = 1
  Material = 1
End
Body 2
  Equation = 1
  Material = 1
End
Body 3
  Equation = 1
  Material = 1
End
Body 4
  Equation = 1
  Material = 1
End
Equation 1
  Active Solvers(1) = 1
End
Material 1
  Density = 1.0
End
Boundary Condition 1
  Target Boundaries(1) = 1
  w = Real 0.0
  Positive Electrode = Logical True
End
Boundary Condition 2
  Target Boundaries(3) = 2 3 4
  Negative Electrode = Logical True
End
Boundary Condition 3
  Target Boundaries(1) = 2
  body 2: w = Real 1.0
End
Solver 1
  Equation = Coil Direction W
  Procedure = "DirectionSolver" "DirectionSolver"
  Variable = w
  Variable DOFs = 1
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStab
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-8
  Linear System Preconditioning = ILU0
End
Solver 2
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = w
  Operator 1 = min
  Variable 2 = w
  Operator 2 = max
  Variable 3 = w Direction
  Operator 3 = max
End
