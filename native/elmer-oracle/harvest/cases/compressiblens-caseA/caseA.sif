Header
  Mesh DB "." "square"
End
Simulation
  Coordinate System = Cartesian
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 1
  Timestep Intervals = 2
  Timestep Sizes = 0.01
  Output Intervals = 1
  Max Output Level = 4
End
Body 1
  Equation = 1
  Material = 1
  Body Force = 1
End
Body 2
  Equation = 1
  Material = 1
End
Body 3
  Equation = 1
  Material = 1
End
Body 4
  Equation = 1
  Material = 1
  Body Force = 1
End
Equation 1
  Active Solvers(1) = 1
End
Material 1
  Equilibrium Temperature = Real 293.0
  Equilibrium Density = Real 1.21
  Viscosity = Real 1.82e-5
  Bulk Viscosity = Real 6.0e-6
  Specific Heat = Real 1005.0
  Heat Conductivity = Real 0.026
  Specific Heat Ratio = Real 1.4
End
Body Force 1
  Body Force 1 = Real 1.0
  Body Force 2 = Real -0.5
  Body Force 3 = Real 0.0
End
Boundary Condition 1
  Target Boundaries(1) = 1
  NSSol 1 = Real 0.0
  NSSol 2 = Real 0.0
  NSSol 3 = Real 0.0
  NSSol 4 = Real 0.0
End
Boundary Condition 2
  Target Boundaries(3) = 2 3 4
  NSSol 1 = Real 0.1
  NSSol 2 = Real 0.0
  NSSol 3 = Real 0.2
  NSSol 4 = Real 0.0
End
Solver 1
  Equation = "Compressible Flow"
  Procedure = "CompressibleNS" "CompressibleNS"
  Variable = -dofs 4 "NSSol"
  Element = "p:1"
  Nonlinear Iteration Method = String picard
  Nonlinear System Max Iterations = Integer 1
  Nonlinear System Convergence Tolerance = Real 1.0e-4
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
End
Solver 2
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = "NSSol 1"
  Operator 1 = min
  Variable 2 = "NSSol 1"
  Operator 2 = max
  Variable 3 = "NSSol 2"
  Operator 3 = min
  Variable 4 = "NSSol 2"
  Operator 4 = max
  Variable 5 = "NSSol 3"
  Operator 5 = min
  Variable 6 = "NSSol 3"
  Operator 6 = max
  Variable 7 = "NSSol 4"
  Operator 7 = min
  Variable 8 = "NSSol 4"
  Operator 8 = max
End
