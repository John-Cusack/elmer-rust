Header
  Mesh DB "." "cube"
End
Simulation
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 2
  Output Intervals = 1
  Max Output Level = Integer 4
End
Body 1
  Equation = 1
  Material = 1
  Initial Condition = 1
End
Initial Condition 1
  Velocity 1 = Variable Coordinate 1
    Real MATC "tx"
  Velocity 2 = Variable Coordinate 2
    Real MATC "tx"
  Velocity 3 = Real 0.2
End
Equation 1
  Active Solvers(3) = 1 2 3
End
Material 1
  Density = 1.0
End
Boundary Condition 1
  Target Boundaries(2) = 2 3
  Tangent Surface = Logical True
End
Solver 1
  Equation = AllocV
  Procedure = "AllocateSolver" "AllocateSolver"
  Variable = Velocity
  Variable DOFs = 3
End
Solver 2
  Equation = FixTang
  Procedure = "FixTangentVelo" "FixTangentVelo"
  Velocity Variable Name = String Velocity
End
Solver 3
  Equation = SaveS
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = FixVelo
  Operator 1 = min
  Variable 2 = FixVelo
  Operator 2 = max
  Variable 3 = Velocity 3
  Operator 3 = min
  Variable 4 = Velocity 3
  Operator 4 = max
End
