  Time Derivative Coefficient = Real 0.0
  Diffusion Coefficient = Real 1.0
  Harmonic Loss Coefficient 1 = Variable frequency
    Real
      0.0 1.0
      3.0 1.0
    End
  Harmonic Loss Coefficient 2 = Variable frequency
    Real
      0.0 2.0
      3.0 2.0
    End
End
Body Force 1
  Field Source = Real 0.0
End
