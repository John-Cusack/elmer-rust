Header
  Mesh DB "." "square"
End
Simulation
  Max Output Level = 4
  Coordinate System = Cartesian
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 1
  Timestep Intervals(1) = 30
  Timestep Sizes(1) = 0.1
  Steady State Max Iterations = 1
  Frequency = Real 1.0
End
Body 1
  Equation = 1
  Material = 1
  Body Force = 1
End
