! T023 CS config A: transient channel, standard form, non-block path,
! outflow surgery + traction post-pass live. Clean-room case (no upstream
! coverage exists for ConsistentSplitting.so).
Header
  Mesh DB "." "chan"
End
Simulation
  Coordinate System = Cartesian 2D
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 1
  Timestep Sizes = Real 0.01
  Timestep Intervals = 2
  Steady State Max Iterations = 2
  Output Intervals = 1
  Max Output Level = 4
End
Equation 1
  Active Solvers(7) = 1 2 3 4 5 6 7
End
Body 1
  Equation = 1
  Material = 1
End
Body 2
  Equation = 1
  Material = 1
End
Body 3
  Equation = 1
  Material = 1
End
Body 4
  Equation = 1
  Material = 1
End
Material 1
  Density = Real 1.0
  Viscosity = Real 0.1
End
Solver 1
  Equation = Divergence Solver
  Procedure = "DivergenceSolver" "DivergenceSolver"
  Variable = Divergence
  Divergence Variable = String "VelocityTot"
  Linear System Solver = Direct
End
Solver 2
  Equation = Velocity
  Procedure = "ConsistentSplitting" "VelocitySolver"
  Variable = VelocityTot
  Variable DOFs = 2
  Block Preconditioning = Logical False
  Nonlinear System Max Iterations = 1
  Nonlinear System Convergence Tolerance = Real 1.0e-5
  Linear System Solver = Direct
End
Solver 3
  Equation = Pressure
  Procedure = "ConsistentSplitting" "PressureSolver"
  Variable = TotalPressure
  Block Preconditioning = Logical False
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStab
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-10
  Linear System Preconditioning = ILU0
End
Solver 4
  Equation = Compressibility
  Procedure = "ConsistentSplitting" "CompressibilitySolver"
  Variable = CompCorr
  Linear System Solver = Direct
End
Solver 5
  Equation = Coupled
  Procedure = "ConsistentSplitting" "OptimalSolutionUpdate"
  Variable = Flow
  Variable DOFs = 3
  Linear System Solver = Direct
End
Solver 6
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = TotalPressure
  Operator 1 = max
  Variable 2 = TotalPressure
  Operator 2 = min
  Variable 7 = TotalPressure
  Operator 7 = norm
  Variable 3 = VelocityTot
  Operator 3 = norm
  Variable 4 = Flow
  Operator 4 = norm
  Variable 5 = Divergence
  Operator 5 = norm
  Variable 6 = CompCorr
  Operator 6 = norm
End
Solver 7
  Exec Solver = After Simulation
  Equation = SaveLine
  Procedure = "SaveData" "SaveLine"
  Filename = line.dat
  Polyline Coordinates(2,2) = 0.0 0.5 1.0 0.5
  Polyline Divisions(1) = 20
End
Boundary Condition 1
  Target Boundaries = 4
  VelocityTot 1 = Real 1.0
  VelocityTot 2 = Real 0.0
  Flow 1 = Real 1.0
  Flow 2 = Real 0.0
  Flow 3 = Real 0.0
End
Boundary Condition 2
  Target Boundaries(3) = 1 2 3
  VelocityTot 1 = Real 0.0
  VelocityTot 2 = Real 0.0
  Flow 1 = Real 0.0
  Flow 2 = Real 0.0
  Flow 3 = Real 0.0
  Calculate Fluidic Force = Logical True
  Outflow Boundary = Logical True
End
