Header
  CHECK KEYWORDS Warn
  Mesh DB "." "square"
  Include Path ""
  Results Directory ""
End
Simulation
  Max Output Level = 6
  Coordinate System = Cartesian
  Simulation Type = Transient
  Steady State Max Iterations = 1
  Output Intervals = 1
  Timestep Intervals = 20
  Timestep Sizes = 0.01
  Timestepping Method = bdf
  Bdf Order = 4
End
Body 1
  Name = "Body"
  Equation = 1
  Material = 1
End
Equation 1
  Name = "Equations"
End
Solver 1
  Equation = Ode
  Procedure = "OdeSolver" "OdeSolver"
  Variable = -global ode
  Variable Dofs = 1
  Time Derivative Order = 1
  Linear System Solver = Direct
  Linear System Save = Logical False
  Active Components = Integer 1
End
Solver 2
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = time
  Variable 2 = Ode
End
Material 1
  Name = "Material"
End
Component 1
  Name = String "Ode Component"
  Stiffness Matrix 11 = Real 1.0
  Damping Matrix 11 = Real 1.0
  Force 1 = Real 1.0
End
