Header
  Mesh DB "." "square"
End
Simulation
  Coordinate System = Cartesian
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = Integer 1
  Timestep Sizes(1) = Real 0.1
  Timestep Intervals(1) = Integer 2
  Output Intervals = 1
  Max Output Level = Integer 4
End
Body 1
  Equation = 1
  Material = 1
  Initial Condition = 1
End
Body 2
  Equation = 1
  Material = 1
  Initial Condition = 1
End
Body 3
  Equation = 1
  Material = 1
  Initial Condition = 1
End
Body 4
  Equation = 1
  Material = 1
  Initial Condition = 1
End
Initial Condition 1
  Velocity 1 = Variable Coordinate 2
    Real MATC "0.1+0.1*tx"
  Velocity 2 = Real 0.0
  Kinetic Energy = Real 0.003
  Kinetic Dissipation = Real 0.0001
End
Equation 1
  Active Solvers(3) = 1 2 3
End
Material 1
  Density = Real 1.0
  Viscosity = Real 1.0e-3
  KE SigmaK = Real 1.0
  KE SigmaE = Real 1.3
  KE C1 = Real 1.44
  KE C2 = Real 1.92
  KE Cmu = Real 0.09
  KE Clip = Real 1.0e-6
End
Boundary Condition 1
  Target Boundaries = 1
  Epsilon Wall BC = Logical True
End
Solver 1
  Equation = AllocateStuff
  Procedure = "AllocateSolver" "AllocateSolver"
  Variable = Velocity
  Variable DOFs = 2
End
Solver 2
  Equation = KEpsEq
  Procedure = "KESolverLegacy" "KESolverLegacy"
  KE Model = String rng
  Bubbles = Logical False
  Nonlinear System Max Iterations = Integer 1
  Nonlinear System Convergence Tolerance = Real 1.0e-5
  Linear System Solver = Direct
  Linear System Direct Method = Umfpack
  Steady State Convergence Tolerance = Real 1.0e-5
End
Solver 3
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = Kinetic Energy
  Operator 1 = min
  Variable 2 = Kinetic Energy
  Operator 2 = max
  Variable 3 = Kinetic Dissipation
  Operator 3 = min
  Variable 4 = Kinetic Dissipation
  Operator 4 = max
End
