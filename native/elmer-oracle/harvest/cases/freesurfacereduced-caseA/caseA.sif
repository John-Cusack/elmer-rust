Header
  Mesh DB "." "coat"
End
Simulation
  Max Output Level = 4
  Coordinate System = Axi Symmetric
  Simulation Type = Steady State
  Steady State Max Iterations = 2
End
Body 1
  Equation = 1
  Material = 1
End
Equation 1
  Active Solvers(3) = 1 2 3
End
Material 1
  Density = 1.0
  Viscosity = 1.0
End
Solver 1
  Equation = Navier-Stokes
  Stabilize = True
  Internal Move Boundary = Logical False
  Nonlinear System Max Iterations = 2
  Nonlinear System Convergence Tolerance = 1.0e-7
  Nonlinear System Newton After Iterations = 2
  Nonlinear System Newton After Tolerance = 1.0e-2
  Nonlinear System Relaxation Factor = 0.7
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStab
  Linear System Preconditioning = ILU1
  Linear System Max Iterations = 100
  Linear System Convergence Tolerance = 1.0e-10
  Steady State Convergence Tolerance = 1.0e-7
End
Solver 2
  Equation = Free Surface Reduced
  Procedure = "FreeSurfaceReduced" "FreeSurfaceReduced"
  Variable = Dx
  Variable DOFs = 1
  Nonlinear System Relaxation Factor = 0.7
  Steady State Convergence Tolerance = 1.0e-3
  Perform Mapping = Logical False
End
Solver 3
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = Dx
  Operator 1 = min
  Variable 2 = Dx
  Operator 2 = max
End
Boundary Condition 1
  Target Boundaries = 1
  Velocity 2 = -10.0
  Velocity 1 = 0.0
End
Boundary Condition 2
  Target Boundaries = 2
  Free Surface Reduced = Logical True
End
Boundary Condition 3
  Target Boundaries = 3
  Velocity 1 = 0.0
End
Boundary Condition 4
  Target Boundaries = 4
  Velocity 1 = 0.0
  Pressure = 0.0
End
Boundary Condition 5
  Target Boundaries = 5
  Velocity 1 = 0.0
  Velocity 2 = 0.0
End
