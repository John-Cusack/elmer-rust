Header
  Mesh DB "." "square"
End
Simulation
  Coordinate System = Cartesian
  Simulation Type = Transient
  Timestep Sizes = 0.05
  Timestep Intervals = 2
  Output Intervals = 1
  Steady State Max Iterations = 1
End
Body 1
  Equation = 1
  Material = 1
End
Body 2
  Equation = 1
  Material = 1
End
Body 3
  Equation = 1
  Material = 1
End
Body 4
  Equation = 1
  Material = 1
End
Equation 1
  Active Solvers(5) = 1 2 3 4 5
  Heat Equation = Logical True
  RateOfChange = Logical True
  Navier-Stokes = Logical True
  Transport = Logical True
End
Material 1
  Density = 1.0
  Heat Conductivity = 1.0
  Viscosity = 1.0
  Advection Velocity 1 = Real 0.5
  Advection Velocity 2 = Real 0.25
End
Boundary Condition 1
  Target Boundaries(1) = 1
  Temperature = Real 0.0
  TempRate = Real 0.0
  Transp = Real 0.0
  Velocity 1 = Real 0.0
  Velocity 2 = Real 0.0
  Pressure = Real 0.0
End
Boundary Condition 2
  Target Boundaries(3) = 2 3 4
  Temperature = Real 2.0
  Transp = Real 1.0
  Velocity 1 = Real 0.1
  Velocity 2 = Real 0.0
End
Solver 1
  Equation = Heat Equation
  Procedure = "HeatSolve" "HeatSolver"
  Variable = Temperature
  Variable DOFs = 1
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStab
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-8
  Linear System Preconditioning = ILU0
End
Solver 2
  Equation = Navier-Stokes
  Procedure = "FlowSolve" "FlowSolver"
  Variable = Flow Solution[velocity:2 pressure:1]
  Stabilization Method = Stabilized
  Steady State Convergence Tolerance = 1.0e-5
  Nonlinear System Convergence Tolerance = 1.0e-8
  Nonlinear System Max Iterations = 1
  Nonlinear System Newton After Iterations = 3
  Nonlinear System Relaxation Factor = 1
  Nonlinear System Newton After Tolerance = 1.0e-3
  Linear System Solver = Iterative
  Linear System Symmetric = True
  Linear System Iterative Method = BicgstabL
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-10
  Linear System Preconditioning = ILU0
End
Solver 3
  Equation = RateOfChange
  Procedure = "RateOfChange" "RateOfChangeSolver"
  Variable = TempRate
  Variable DOFs = 1
  Advection Variable = String Temperature
  Advection = String computed
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStab
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-8
  Linear System Preconditioning = ILU0
End
Solver 4
  Equation = Transport
  Procedure = "TransportEquation" "TransportEquationSolver"
  Variable = Transp
  Variable DOFs = 1
  Time Derivative Order = 2
  Advection Variable = String Temperature
  Rate Of Change Equation Variable = String TempRate
  Advection = String computed
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStab
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-8
  Linear System Preconditioning = ILU0
End
Solver 5
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = Transp
  Operator 1 = min
  Variable 2 = Transp
  Operator 2 = max
End
