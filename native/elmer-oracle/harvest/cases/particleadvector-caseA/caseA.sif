Header
  Mesh DB "." "square"
End
Simulation
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 2
  Output Intervals = 1
  Max Output Level = 5
End
Body 1
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
End
Body 2
  Target Bodies(1) = 2
  Equation = 1
  Material = 1
End
Body 3
  Target Bodies(1) = 3
  Equation = 1
  Material = 1
End
Body 4
  Target Bodies(1) = 4
  Equation = 1
  Material = 1
End
Equation 1
  Active Solvers(3) = 1 2 3
End
Material 1
  Density = 1.0
  Viscosity = 0.1
End
Boundary Condition 1
  Target Boundaries(3) = 1 2 4
  Velocity 1 = 0.0
  Velocity 2 = 0.0
End
Boundary Condition 2
  Target Boundaries(1) = 3
  Velocity 1 = Real 1.0
  Velocity 2 = 0.0
End
Solver 1
  Equation = Navier-Stokes
  Procedure = "FlowSolve" "FlowSolver"
  Variable = Flow Solution[Velocity:2 Pressure:1]
  Exec Solver = Always
  Stabilize = True
  Bubbles = False
  Nonlinear System Convergence Tolerance = 1.0e-8
  Nonlinear System Max Iterations = 1
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStab
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-8
  Linear System Preconditioning = ILU1
End
Solver 2
  Equation = ParticleAdvector
  Procedure = "ParticleAdvector" "ParticleAdvector"
  Simulation Timestep Sizes = Logical False
  Timestep Size = Real 0.02
  Max Timestep Intervals = Integer 5
  Norm Variable Index = Integer 1
  Particle Info = Logical True
  Variable 1 = String "Pressure"
  Variable 2 = String "Particle Status"
  Variable 3 = String "Particle Distance"
End
Solver 3
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = adv Pressure
  Operator 1 = max
  Variable 2 = adv Pressure
  Operator 2 = min
End
