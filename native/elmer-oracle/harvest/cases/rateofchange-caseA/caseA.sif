Header
  Mesh DB "." "square"
End
Simulation
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 1
End
Body 1
  Equation = 1
  Material = 1
End
Body 2
  Equation = 1
  Material = 1
End
Body 3
  Equation = 1
  Material = 1
End
Body 4
  Equation = 1
  Material = 1
End
Equation 1
  Active Solvers(3) = 1 2 3
  Heat Equation = Logical True
  RateOfChange = Logical True
End
Material 1
  Density = 1.0
  Heat Conductivity = 1.0
  Advection Velocity 1 = Real 0.5
  Advection Velocity 2 = Real 0.25
End
Boundary Condition 1
  Target Boundaries(1) = 1
  Temperature = Real 0.0
  TempRate = Real 0.0
End
Boundary Condition 2
  Target Boundaries(3) = 2 3 4
  Temperature = Real 1.0
End
Solver 1
  Equation = Heat Equation
  Procedure = "HeatSolve" "HeatSolver"
  Variable = Temperature
  Variable DOFs = 1
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStab
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-8
  Linear System Preconditioning = ILU0
End
Solver 2
  Equation = RateOfChange
  Procedure = "RateOfChange" "RateOfChangeSolver"
  Variable = TempRate
  Variable DOFs = 1
  Advection Variable = String Temperature
  Advection = String constant
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStab
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-8
  Linear System Preconditioning = ILU0
End
Solver 3
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = TempRate
  Operator 1 = min
  Variable 2 = TempRate
  Operator 2 = max
End
