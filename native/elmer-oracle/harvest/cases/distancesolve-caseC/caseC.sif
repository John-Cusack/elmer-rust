Header
  Mesh DB "." "square"
End
Simulation
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 1
  Max Output Level = 4
End
Body 1
  Equation = 1
  Material = 1
  Body Force = 1
End
Body 2
  Equation = 1
  Material = 1
End
Body 3
  Equation = 1
  Material = 1
End
Body 4
  Equation = 1
  Material = 1
End
Equation 1
  Active Solvers(1) = 1
End
Material 1
  Density = 1.0
End
Body Force 1
  Distance = Real 0.0
  Distance Condition = Real 1.0
End
Boundary Condition 1
  Target Boundaries(1) = 1
  Distance = Real 0.0
End
Boundary Condition 2
  Target Boundaries(3) = 2 3 4
  Noslip Wall BC = Logical True
End
Solver 1
  Equation = DistanceGeom
  Procedure = "DistanceSolve" "DistanceSolver1"
  Variable = Distance
  Variable DOFs = 1
  Dummy Distance Computation = Logical False
End
Solver 2
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = Distance
  Operator 1 = min
  Variable 2 = Distance
  Operator 2 = max
End
