Header
  Mesh DB "." "square"
End
Simulation
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 2
  Output Intervals = 1
End
Body 1
  Equation = 1
  Material = 1
End
Body 2
  Equation = 1
  Material = 1
End
Body 3
  Equation = 1
  Material = 1
End
Body 4
  Equation = 1
  Material = 1
End
Equation 1
  Active Solvers(3) = 1 2 3
End
Material 1
  Density = 1.0
  Viscosity = 1.0e-3
End
Boundary Condition 1
  Target Boundaries(1) = 1
  Velocity 1 = 0.0
  Velocity 2 = 0.0
End
Boundary Condition 2
  Target Boundaries(2) = 2 4
  Velocity 1 = 0.0
  Velocity 2 = 0.0
End
Boundary Condition 3
  Target Boundaries(1) = 3
  Velocity 1 = 1.0
  Velocity 2 = 0.0
End
Solver 1
  Equation = Navier-Stokes
  Procedure = "FlowSolve" "FlowSolver"
  Variable = Flow Solution[Velocity:2 Pressure:1]
  Exec Solver = Always
  Stabilize = True
  Nonlinear System Convergence Tolerance = 1.0e-8
  Nonlinear System Max Iterations = 1
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStabL
  BiCgStabl Polynomial Degree = 4
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-8
  Linear System Preconditioning = ILU0
  Linear System Abort Not Converged = False
End
Solver 2
  Equation = Shearrate
  Procedure = "ShearrateSolver" "ShearrateSolver"
  Target Variable = String velocity
  Calculate Viscosity = Logical True
  Exec Solver = Always
End
Solver 3
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = Shearrate velocity
  Operator 1 = min
  Variable 2 = Shearrate velocity
  Operator 2 = max
  Variable 3 = Viscosity velocity
  Operator 3 = max
  Variable 4 = Viscosity velocity
  Operator 4 = min
End
