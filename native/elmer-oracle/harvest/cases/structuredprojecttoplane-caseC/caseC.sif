Header
  Mesh DB "." "cube"
End
Simulation
  Coordinate System = Cartesian
  Coordinate Mapping(3) = 1 2 3
  Simulation Type = Steady State
  Steady State Max Iterations = 2
  Output Intervals = 1
  Max Output Level = 5
End
Body 1
  Equation = 1
  Material = 1
  Body Force = 1
End
Equation 1
  Active Solvers(3) = 1 2 3
End
Material 1
  Density = 1.0
  Heat Conductivity = 1.0
End
Body Force 1
  Heat Source = Real 10.0
End
Boundary Condition 1
  Target Boundaries(4) = 1 2 3 4
End
Boundary Condition 2
  Target Boundaries(1) = 5
  Temperature = Real 1.0
End
Boundary Condition 3
  Target Boundaries(1) = 6
  Temperature = Real 0.0
End
Solver 1
  Equation = Heat Equation
  Variable = String Temperature
  Variable DOFs = 1
  Procedure = "HeatSolve" "HeatSolver"
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStab
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-8
  Linear System Preconditioning = none
  Linear System Residual Output = 1
  Steady State Convergence Tolerance = 1.0e-5
  Nonlinear System Convergence Tolerance = 1.0e-5
  Nonlinear System Max Iterations = 1
  Nonlinear System Newton After Iterations = 3
  Nonlinear System Newton After Tolerance = 1.0e-2
  Nonlinear System Relaxation Factor = 1.0
End
Solver 2
  Equation = HeightDepth
  Procedure = "StructuredProjectToPlane" "StructuredProjectToPlane"
  Active Coordinate = Integer 3
  Variable 1 = Temperature
  Operator 1 = top
  Target Variable 1 = String bot_temp
  Variable 2 = Temperature
  Operator 2 = top
  Target Variable 2 = String top_temp
  Target Variable 2 At Bottom = Logical True
  Variable 3 = Temperature
  Operator 3 = min
  Target Variable 3 = String min_temp
  Variable 4 = Temperature
  Operator 4 = max
  Target Variable 4 = String max_temp
  Variable 5 = Temperature
  Operator 5 = isosurface
  Isosurface Value 5 = Real 0.5
  Target Variable 5 = String iso_temp
End
Solver 3
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = Temperature
  Operator 1 = max
  Variable 2 = bot_temp
  Operator 2 = max
  Variable 3 = top_temp
  Operator 3 = min
  Variable 4 = min_temp
  Operator 4 = max
  Variable 5 = max_temp
  Operator 5 = min
  Variable 6 = iso_temp
  Operator 6 = max
End
