Header
  CHECK KEYWORDS Warn
  Mesh DB "." "mesh"
End

Simulation
  Coordinate System = Cartesian 2D
  Simulation Type = Transient
  Steady State Max Iterations = 1
  Timestepping Method = BDF
  BDF Order = 1
  Timestep Intervals = 2
  Timestep Sizes = 0.5
  Output Intervals = 0
  Comment = String "two cell SaveData reference"
End

Body 1
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
  Initial Condition = 1
End

Body 2
  Target Bodies(1) = 2
  Equation = 1
  Material = 1
  Body Force = 1
  Initial Condition = 1
  Save This = Logical True
End

Equation 1
  Active Solvers(4) = 1 2 3 4
End

Material 1
  Heat Conductivity = 1.0
  Density = 1.0
  Heat Capacity = 2.0
End

Body Force 1
  Heat Source = 4.0
End

Initial Condition 1
  Temperature = 0.0
End

Boundary Condition 1
  Target Boundaries(1) = 1
  Heat Flux = 0.0
  Save This = Logical True
  Save Line = Logical True
End

Boundary Condition 2
  Target Boundaries(1) = 3
  Heat Flux = 0.0
  Flux Integrate = Logical True
  Save Line = Logical True
End

Boundary Condition 3
  Target Boundaries(1) = 4
  Temperature = 0.0
End

Boundary Condition 4
  Target Boundaries(1) = 2
  Temperature = 10.0
End

Solver 1
  Equation = Heat Equation
  Procedure = "HeatSolve" "HeatSolver"
  Variable = Temperature
  Linear System Solver = Direct
  Linear System Direct Method = Banded
  Steady State Convergence Tolerance = 1.0e-10
  Nonlinear System Max Iterations = 1
End

Solver 2
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = Temperature
  Operator 1 = max
  Operator 2 = min
  Operator 3 = mean
  Operator 4 = sum
  Operator 5 = range
  Operator 6 = variance
  Operator 7 = int
  Target Variable 7 = Temperature Integral
  Operator 8 = int mean
  Operator 9 = volume
  Mask Name 10 = Save This
  Operator 10 = body int
  Operator 11 = body mean
  Operator 12 = boundary sum
  Operator 13 = boundary int
  Operator 14 = boundary int mean
  Operator 15 = area
  Operator 16 = nodes
  Operator 17 = elements
  Operator 18 = dofs
  Operator 19 = norm
  Operator 20 = bounding box
  Save Points(2) = Integer 1 5
  Save Coordinates(1,2) = Real 2.9 0.9
End

Solver 3
  Equation = SaveReader
  Procedure = "SaveData" "SaveScalars"
  Filename = reader.dat
  Variable 1 = Temperature Integral
  Operator 1 = max
  Show Norm Index = Integer 1
End

Solver 4
  Equation = SaveLine
  Procedure = "SaveData" "SaveLine"
  Filename = line.dat
  Variable 1 = Temperature
End
