! Stabilized Q1/Q1 Navier-Stokes in 3D on 4 x 2 x 2 bricks (Picard, then
! Newton after 2 iterations): plug inflow, slip walls, External Pressure
! outlet along the 3D face normal.
Header
  CHECK KEYWORDS Warn
  Mesh DB "." "box"
  Include Path ""
  Results Directory ""
End

Constants
  Gravity(4) = 0 -1 0 9.82
End

Equation 1
  Active Solvers(1) = 1
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 1
  Output File = "case.result"
  Ascii Output = Logical True
End

Body 1
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
End

Solver 1
  Equation = Navier-Stokes
  Procedure = "FlowSolve" "FlowSolver"
  Variable = Flow Solution[Velocity:3 Pressure:1]
  Stabilize = True
  Nonlinear System Max Iterations = 20
  Nonlinear System Convergence Tolerance = 1.0e-10
  Nonlinear System Newton After Iterations = 2
  Nonlinear System Newton After Tolerance = 1.0e-3
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
End

Material 1
  Density = 1.0
  Viscosity = 0.1
End

Boundary Condition 1
  Target Boundaries(2) = 1 3
  Name = "Walls y"
  Velocity 2 = 0.0
  Slip Coefficient 1 = 2.0
  Slip Coefficient 3 = 2.0
End

Boundary Condition 2
  Target Boundaries(2) = 5 6
  Name = "Walls z"
  Velocity 3 = 0.0
  Slip Coefficient 1 = 2.0
  Slip Coefficient 2 = 2.0
End

Boundary Condition 3
  Target Boundaries(1) = 4
  Name = "Inflow"
  Velocity 1 = 1.0
  Velocity 2 = 0.0
  Velocity 3 = 0.0
End

Boundary Condition 4
  Target Boundaries(1) = 2
  Name = "Outlet"
  External Pressure = 0.2
End
