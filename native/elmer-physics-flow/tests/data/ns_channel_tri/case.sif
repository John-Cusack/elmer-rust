! Stabilized P1/P1 Navier-Stokes (Picard, then Newton after 3 iterations),
! plug inflow into a channel with slip walls (derived from the quick test
! ChannelFlowCoulomb: same rect geometry, boundary numbering and the
! "Slip Coefficient 1" wall condition), triangulated mesh.
Header
  CHECK KEYWORDS Warn
  Mesh DB "." "rect"
  Include Path ""
  Results Directory ""
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 1
  Output File = "case.result"
  Ascii Output = Logical True
End

Constants
  Gravity(4) = 0 -1 0 9.82
End

Body 1
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
End

Solver 1
  Equation = Navier-Stokes
  Procedure = "FlowSolve" "FlowSolver"
  Variable = Flow Solution[Velocity:2 Pressure:1]
  Stabilize = True
  Nonlinear System Max Iterations = 30
  Nonlinear System Convergence Tolerance = 1.0e-10
  Nonlinear System Newton After Iterations = 3
  Nonlinear System Newton After Tolerance = 1.0e-3
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
End

Equation 1
  Active Solvers(1) = 1
End

Material 1
  Density = 1.0
  Viscosity = 0.02
End

Boundary Condition 1
  Target Boundaries(2) = 1 3
  Name = "Walls"
  Velocity 2 = 0.0
  Slip Coefficient 1 = 10.0
End

Boundary Condition 2
  Target Boundaries(1) = 4
  Name = "Inflow"
  Velocity 1 = 1.0
  Velocity 2 = 0.0
End
