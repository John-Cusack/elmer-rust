! Stabilized P1/P1 Stokes, body-force driven channel (derived from the
! quick test ChannelFlowCoulomb: same rect geometry and boundary numbering).
Header
  CHECK KEYWORDS Warn
  Mesh DB "." "rect"
  Include Path ""
  Results Directory ""
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 1
  Output File = "case.result"
  Ascii Output = Logical True
End

Constants
  Gravity(4) = 0 -1 0 9.82
End

Body 1
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
  Body Force = 1
End

Body Force 1
  Flow BodyForce 1 = 1.0
End

Solver 1
  Equation = Navier-Stokes
  Procedure = "FlowSolve" "FlowSolver"
  Variable = Flow Solution[Velocity:2 Pressure:1]
  Flow Model = Stokes
  Stabilize = True
  Nonlinear System Max Iterations = 1
  Nonlinear System Convergence Tolerance = 1.0e-8
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
End

Equation 1
  Active Solvers(1) = 1
End

Material 1
  Density = 1.0
  Viscosity = 0.5
End

Boundary Condition 1
  Target Boundaries(2) = 1 3
  Name = "Walls"
  Velocity 1 = 0.0
  Velocity 2 = 0.0
End

Boundary Condition 2
  Target Boundaries(1) = 2
  Name = "Right"
  Velocity 2 = 0.0
  External Pressure = 0.25
End

Boundary Condition 3
  Target Boundaries(1) = 4
  Name = "Left"
  Velocity 2 = 0.0
End
