! Stabilized P1/P1 flow without convection (Flow Model = No Convection),
! Gradp and Laplace Discretization, a Normal Pressure and Mass Flux inlet and
! a fixed-pressure outlet (derived from the quick test ChannelFlowCoulomb: same rect geometry
! and boundary numbering), triangulated mesh.
Header
  CHECK KEYWORDS Warn
  Mesh DB "." "rect"
  Include Path ""
  Results Directory ""
End

Constants
  Gravity(4) = 0 -1 0 9.82
End

Equation 1
  Active Solvers(1) = 1
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 1
  Output File = "case.result"
  Ascii Output = Logical True
End

Body 1
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
End

Solver 1
  Equation = Navier-Stokes
  Procedure = "FlowSolve" "FlowSolver"
  Variable = Flow Solution[Velocity:2 Pressure:1]
  Flow Model = No Convection
  Stabilization Method = Stabilized
  Gradp Discretization = True
  Laplace Discretization = True
  Nonlinear System Max Iterations = 1
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
End

Material 1
  Density = 1.5
  Viscosity = 1.0
End

Boundary Condition 1
  Target Boundaries(2) = 1 3
  Name = "Walls"
  Velocity 1 = 0.0
  Velocity 2 = 0.0
End

Boundary Condition 2
  Target Boundaries(1) = 4
  Name = "Inlet"
  Normal Pressure = Real -1.0
  Mass Flux = 0.1
  Velocity 2 = 0.0
End

Boundary Condition 3
  Target Boundaries(1) = 2
  Name = "Outlet"
  Pressure = 0.0
  Velocity 2 = 0.0
End
