Check Keywords "Warn"

Header :: Mesh DB "." "square"

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 2
  Timestep Sizes = 0.05
  Timestep Intervals = 6
  Output Intervals(1) = 1
  Steady State Max Iterations = 1
  Output File = "evol.result"
End

Body 1
  Equation = 1
  Material = 1
  Body Force = 1
End

Material 1
  Convection Velocity 1 = 1
  Convection Velocity 2 = 0

  diffusion coefficient = 1.0
  convection coefficient = 9.0
  time derivative coefficient = 2.0
  reaction coefficient = 0.5
End

Body Force 1 :: Field Source = Real 1
Equation 1 :: Active Solvers(1) = 1

Solver 1
  Equation = "ModelPDE"
  Variable = "Field"
  Procedure = "ModelPDE" "AdvDiffSolver"
  Linear System Solver = Direct
  Steady State Convergence Tolerance = 1e-9
End

Boundary Condition 1
  Target Boundaries(1) = 1
  Field = 0.0
End

Boundary Condition 2
  Target Boundaries(1) = 2
  Robin Coefficient = 10.0
  External Field = 5.0
End

Boundary Condition 3
  Target Boundaries(2) = 3 4
  Field Flux = 10.0
End

