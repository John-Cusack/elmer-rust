Header
  CHECK KEYWORDS Warn
  Mesh DB "." "triangle"
End

Simulation
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 1
  Timestep Intervals = 3
  Timestep Sizes = 0.1
  Output Intervals = 1
  Steady State Max Iterations = 1
  Post File = case.ep
  Output File = case.result

End

Body 1
  Name = "Plate"
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
  Initial Condition = 1
End

Initial Condition 1
  Temperature = 0.0
End

Solver 1
  Equation = Heat Equation
  Procedure = "HeatSolve" "HeatSolver"
  Variable = Temperature
  Linear System Solver = Direct
End

Solver 2
  Exec Solver = After Timestep
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = Temperature
  Operator 1 = max
  Operator 2 = min
  Operator 3 = mean
  Operator 4 = sum
  Variable 2 = Temperature
  Operator 5 = int mean
End

Solver 3
  Exec Solver = After Timestep
  Equation = SaveLine
  Procedure = "SaveData" "SaveLine"
  Filename = line.dat
  Save Mask = String "Save Line"
End

Equation 1
  Active Solvers(3) = 1 2 3
End

Material 1
  Heat Conductivity = 1
  Density = 1
  Heat Capacity = 1
End

Boundary Condition 1
  Name = "Fixed"
  Target Boundaries(1) = 2
  Temperature = 0
End

Boundary Condition 2
  Name = "Flux side"
  Target Boundaries(1) = 3
  Heat Flux = 1
  Save Line = Logical True
End
