
Header
  Mesh DB "." "d3d"
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 0
  Optimize Bandwidth = Logical False
End

Body 1
  Equation = 1
  Material = 1
  Body Force = 1
End

Material 1
  Density = 1.0
  Youngs Modulus = 2.0e5
  Poisson Ratio = 0.33
End
Body Force 1
  Stress Bodyforce 1 = Real 10.0
  Stress Bodyforce 2 = Real -5.0
  Stress Bodyforce 3 = Real 2.0
End
Equation 1
  Active Solvers(1) = 1
End

Solver 1
  Equation = "Elasticity"
  Procedure = "ElasticSolve" "ElasticSolver"
  Variable = -dofs 3 Displacement

  Large Deflection = False

  Displace Mesh = Logical False

  Linear System Solver = Direct
  Linear System Direct Method = UMFPack

  Nonlinear System Max Iterations = 1
  Linear System Save = Logical True
  Linear System Save Perm = Logical True
  Nonlinear System Convergence Tolerance = 1.0e-11
  Steady State Convergence Tolerance = 1.0e-9
End

Boundary Condition 1
  Target Boundaries(1) = 5
  Displacement 1 = Real 0.0
  Displacement 2 = Real 0.0
  Displacement 3 = Real 0.0
End

Boundary Condition 2
  Target Boundaries(1) = 6
  Surface Traction 1 = Real 100.0
  Surface Traction 3 = Real -40.0
  Normal Surface Traction = Real 25.0
End
Boundary Condition 3
  Target Boundaries(1) = 1
  Spring = Real 300.0
End

Boundary Condition 2
  Target Boundaries(1) = 6
  Surface Traction 1 = Real 100.0
  Surface Traction 3 = Real -40.0
  Normal Surface Traction = Real 25.0
End

Boundary Condition 3
  Target Boundaries(1) = 1
  Spring = Real 300.0
End
