Header
  Mesh DB "." "."
End
Simulation
  Max Output Level = 5
  Coordinate System = Cartesian 2D
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Optimize Bandwidth = Logical False
End
Body 1
  Equation = 1
  Material = 1
  Body Force = 1
End
Body Force 1
  Stress Bodyforce 1 = Real 1.0e3
  Stress Bodyforce 2 = Real -2.0e3
End
Material 1
  Density = 1.0
  Youngs Modulus = Variable Coordinate 1
    Real
      0.0 7.0e10
      0.1 1.0e11
      0.3 2.0e11
    End
  Poisson Ratio = Variable Coordinate 2
    Real
      0.0 0.25
      0.05 0.3
      0.1 0.4
    End
  Youngs Modulus at IP = Logical True
  Poisson Ratio at IP = Logical True
End
Solver 1
  Equation = Stress Solver
  Variable = Displacement
  Variable DOFs = 2
  Procedure = "StressSolve" "StressSolver"
  Linear System Solver = Direct
  Linear System Direct Method = Umfpack
  Nonlinear System Max Iterations = 1
  Calculate Stresses = Logical True
End
Solver 2
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Exec Solver = After Timestep
  Variable 1 = Displacement 1
  Operator 1 = sum
  Variable 2 = Displacement 1
  Operator 2 = max abs
  Variable 3 = Displacement 2
  Operator 3 = sum
  Variable 4 = Displacement 2
  Operator 4 = max abs
  Variable 5 = Stress_xx
  Operator 5 = sum
  Variable 6 = Stress_xx
  Operator 6 = max abs
  Variable 7 = Stress_yy
  Operator 7 = sum
  Variable 8 = Stress_yy
  Operator 8 = max abs
  Variable 9 = Stress_xy
  Operator 9 = sum
  Variable 10 = Stress_xy
  Operator 10 = max abs
  Variable 11 = vonMises
  Operator 11 = sum
  Variable 12 = vonMises
  Operator 12 = max abs
End
Equation 1
  Active Solvers(2) = 1 2
  Plane Stress = False
End
Boundary Condition 1
  Target Boundaries = 1
  Displacement 1 = 0
  Displacement 2 = 0
End
Boundary Condition 2
  Target Boundaries = 2
  Surface Traction 2 = Real -5.0e7
  Normal Surface Traction = Real 1.0e6
End
