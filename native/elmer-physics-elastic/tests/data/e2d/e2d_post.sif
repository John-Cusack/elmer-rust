Header
  Mesh DB "." "."
End
Simulation
  Max Output Level = 5
  Coordinate System = Axi Symmetric
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Optimize Bandwidth = Logical False
End
Body 1
  Equation = 1
  Material = 1
  Body Force = 1
End
Body Force 1
  Stress Bodyforce 1 = Real 1.0e3
  Stress Bodyforce 2 = Real -2.0e3
  Stress Pressure = Real 5.0e2
End
Material 1
  Density = 1.0
  Youngs Modulus = 70e9
  Poisson Ratio = 0.3
End
Solver 1
  Equation = Stress Solver
  Variable = Displacement
  Variable DOFs = 2
  Procedure = "StressSolve" "StressSolver"
  Linear System Solver = Direct
  Linear System Direct Method = Umfpack
  Nonlinear System Max Iterations = 1
  Calculate Stresses = Logical True
  Calculate Strains = Logical True
  Calculate Principal = Logical True
End
Solver 2
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Exec Solver = After Timestep
  Variable 1 = Stress_xx
  Operator 1 = sum
  Variable 2 = Stress_xx
  Operator 2 = norm
  Variable 3 = Stress_xx
  Operator 3 = max abs
  Variable 4 = Stress_yy
  Operator 4 = sum
  Variable 5 = Stress_yy
  Operator 5 = norm
  Variable 6 = Stress_yy
  Operator 6 = max abs
  Variable 7 = Stress_zz
  Operator 7 = sum
  Variable 8 = Stress_zz
  Operator 8 = norm
  Variable 9 = Stress_zz
  Operator 9 = max abs
  Variable 10 = Stress_xy
  Operator 10 = sum
  Variable 11 = Stress_xy
  Operator 11 = norm
  Variable 12 = Stress_xy
  Operator 12 = max abs
  Variable 13 = vonMises
  Operator 13 = sum
  Variable 14 = vonMises
  Operator 14 = norm
  Variable 15 = vonMises
  Operator 15 = max abs
  Variable 16 = Strain_xx
  Operator 16 = sum
  Variable 17 = Strain_xx
  Operator 17 = norm
  Variable 18 = Strain_xx
  Operator 18 = max abs
  Variable 19 = Strain_yy
  Operator 19 = sum
  Variable 20 = Strain_yy
  Operator 20 = norm
  Variable 21 = Strain_yy
  Operator 21 = max abs
  Variable 22 = Strain_zz
  Operator 22 = sum
  Variable 23 = Strain_zz
  Operator 23 = norm
  Variable 24 = Strain_zz
  Operator 24 = max abs
  Variable 25 = Strain_xy
  Operator 25 = sum
  Variable 26 = Strain_xy
  Operator 26 = norm
  Variable 27 = Strain_xy
  Operator 27 = max abs
  Variable 28 = Tresca
  Operator 28 = sum
  Variable 29 = Tresca
  Operator 29 = norm
  Variable 30 = Tresca
  Operator 30 = max abs
  Variable 31 = Principal Stress 1
  Operator 31 = sum
  Variable 32 = Principal Stress 1
  Operator 32 = norm
  Variable 33 = Principal Stress 1
  Operator 33 = max abs
  Variable 34 = Principal Stress 3
  Operator 34 = sum
  Variable 35 = Principal Stress 3
  Operator 35 = norm
  Variable 36 = Principal Stress 3
  Operator 36 = max abs
  Variable 37 = Principal Strain 1
  Operator 37 = sum
  Variable 38 = Principal Strain 1
  Operator 38 = norm
  Variable 39 = Principal Strain 1
  Operator 39 = max abs
End
Equation 1
  Active Solvers(2) = 1 2
  Plane Stress = False
End
Boundary Condition 1
  Target Boundaries = 1
  Displacement 1 = 0
  Displacement 2 = 0
End
Boundary Condition 2
  Target Boundaries = 2
  Surface Traction 2 = Real -5.0e7
  Normal Surface Traction = Real 1.0e6
End
Boundary Condition 3
  Target Boundaries = 3
  Spring = Real 2.0e9
  Normal Surface Traction = Real 3.0e5
End
Boundary Condition 4
  Target Boundaries = 4
  Spring 1 = Real 1.0e9
  Spring 2 = Real 4.0e9
  Spring 12 = Real 5.0e8
  Surface Traction 1 = Real 2.0e5
End
